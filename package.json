{
  "name": "payload-mcp-toolkit",
  "version": "0.10.0-next.0",
  "description": "Standalone schema-aware MCP plugin for Payload CMS v4 \u00e2\u20ac\u201d owns the /api/mcp endpoint, scoped API keys, draft workflow, and AI-friendly tools so non-technical editors can manage content via AI chat.",
  "license": "MIT",
  "author": "jon8800",
  "homepage": "https://github.com/jon8800/payload-mcp-toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jon8800/payload-mcp-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/jon8800/payload-mcp-toolkit/issues"
  },
  "type": "module",
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "mcp",
    "model-context-protocol",
    "ai",
    "cms",
    "content-management"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "import": "./src/components/index.ts",
      "types": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "docs/oauth.md",
    "!dist/__tests__",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm copyfiles && pnpm build:types && pnpm build:swc && node scripts/finalize-build.mjs",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,svg,json}\" dist/",
    "dev": "next dev dev --turbo",
    "dev:generate-importmap": "cd dev && cross-env PAYLOAD_CONFIG_PATH=./payload.config.ts payload generate:importmap",
    "dev:generate-types": "cd dev && cross-env PAYLOAD_CONFIG_PATH=./payload.config.ts payload generate:types",
    "dev:payload": "cd dev && cross-env PAYLOAD_CONFIG_PATH=./payload.config.ts payload",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs",
    "prepublishOnly": "pnpm build && pnpm test && node --test scripts/release-target.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.build.json --noEmit --emitDeclarationOnly false && tsc -p dev --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "mcp-handler": "^1.1.0"
  },
  "peerDependencies": {
    "@payloadcms/ui": "4.0.0-beta.3",
    "payload": "4.0.0-beta.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@payloadcms/db-sqlite": "4.0.0-beta.3",
    "@payloadcms/next": "4.0.0-beta.3",
    "@payloadcms/richtext-lexical": "4.0.0-beta.3",
    "@payloadcms/ui": "4.0.0-beta.3",
    "@swc/cli": "0.6.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "copyfiles": "2.4.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "16.4.2",
    "payload": "4.0.0-beta.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "^5.0.5",
    "sharp": "0.34.2",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "zod": "3.25.76",
    "vite": "8.3.4",
    "@swc/core": "1.15.43",
    "esbuild": "0.28.2",
    "monaco-editor": "0.57.0",
    "yjs": "13.6.33"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=9"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "import": "./dist/components/index.js",
        "types": "./dist/components/index.d.ts",
        "default": "./dist/components/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "tag": "next"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "better-sqlite3",
      "@swc/core"
    ]
  },
  "packageManager": "pnpm@10.30.3"
}
