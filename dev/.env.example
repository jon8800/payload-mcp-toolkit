# Local SQLite database file (created automatically on first run)
DATABASE_URI=file:./dev.db

# Payload secret — change for any non-disposable use
PAYLOAD_SECRET=change-me-to-a-random-string

# Public site URL used for preview link generation
SITE_URL=http://localhost:3000

# Secret embedded in preview URLs by the toolkit
PREVIEW_SECRET=preview-secret-change-me
