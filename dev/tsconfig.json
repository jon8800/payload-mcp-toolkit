{
  "extends": "../tsconfig.json",
  "exclude": ["node_modules", ".next", "../src/**/*.test.ts", "../src/**/__tests__/**"],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/**/*.ts",
    "next.config.mjs",
    ".next/types/**/*.ts"
  ],
  "compilerOptions": {
    "paths": {
      "@payload-config": ["./payload.config.ts"],
      "payload-mcp-toolkit": ["../src/index.ts"],
      "payload-mcp-toolkit/client": ["../src/components/index.ts"]
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "plugins": [{ "name": "next" }],
    "noEmit": true,
    "declaration": false,
    "emitDeclarationOnly": false
  }
}
