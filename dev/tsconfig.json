{
  "extends": "../tsconfig.json",
  "exclude": [],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/**/*.ts",
    "next.config.mjs",
    ".next/types/**/*.ts"
  ],
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@payload-config": ["./payload.config.ts"],
      "payload-mcp-toolkit": ["../src/index.ts"],
      "payload-mcp-toolkit/client": ["../src/components/index.ts"]
    },
    "noEmit": true,
    "emitDeclarationOnly": false
  }
}
